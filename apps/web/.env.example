# Copy to .env.local to override locally. Every value here is public: it ends up in the browser.

# Google Analytics 4 measurement id. Loaded only after the visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0K812W2N8F

# Meta Pixel id (numeric). Empty keeps the pixel off; when set, it also waits for consent.
NEXT_PUBLIC_META_PIXEL_ID=
