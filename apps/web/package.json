{
  "name": "@virkum/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "virkum.is — the Virkum website (Next.js, static export).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@next/third-parties": "16.4.6",
    "@virkum/basalt": "workspace:*",
    "@virkum/ui": "workspace:*",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@virkum/eslint-config": "workspace:*",
    "@virkum/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
